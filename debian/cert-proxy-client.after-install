# Enable the timer on first install. Do this whether or not credentials have
# been provisioned yet: cert-proxy-client.service has ConditionPathExists for
# client-ssl.pem, so early timer runs are skipped cleanly and provisioning the
# file later needs no second package configuration step.
#
# Only on first install ($2 empty), so an admin who disables the timer keeps it
# disabled across upgrades. systemctl may be absent: the package dependency can
# be satisfied by standalone sysusers/tmpfiles binaries without the manager.
if [ -z "$2" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl --system preset cert-proxy-client.timer >/dev/null 2>&1 || true

    if systemctl --system is-enabled cert-proxy-client.timer >/dev/null 2>&1; then
        systemctl --system start cert-proxy-client.timer >/dev/null 2>&1 || true
    fi
fi
