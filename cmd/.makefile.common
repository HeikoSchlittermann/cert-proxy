.PHONY: all build install clean

prefix ?= /usr/local
bindir ?= ${DESTDIR}/${prefix}/bin

ifeq (${GOOS},windows)
PACKAGE := ${PACKAGE}.exe
bindir := ${bindir}/windows_$(shell go env GOARCH)
endif


export GOPATH=${shell pwd}/../../go

v = $(shell git describe --always --dirty=+)

all: build

build clean:	../../go/src/cert-proxy
		go $@ -ldflags '-X cert-proxy/internal/program.Version=$v'

install: build
	install -d ${bindir}
	install --strip ${PACKAGE} ${bindir}/

distclean:	clean
	-rm -rf ../../go

../../go/src/cert-proxy:
	install -d ../../go/src
	ln -sf ../.. ../../go/src/cert-proxy
